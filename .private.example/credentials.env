# vmui — TEMPLATE for .private/credentials.env
#
# Copy this file to .private/credentials.env and fill in real values:
#
#   mkdir .private
#   cp .private.example/credentials.env .private/credentials.env
#
# .private/ is gitignored; this template is tracked and must contain NO real
# credentials. Consumed by scripts/lib/guest-credentials.{sh,ps1}.
#
# Any value already exported in the environment wins over this file, so CI can
# inject credentials without writing them to disk.

# macOS guest (OSX-KVM, ssh 127.0.0.1:10022)
MAC_GUEST_USER=dragos
MAC_GUEST_PASS=CHANGE_ME
# macOS guest on GCE (infra/devcloud/mac, vmui-mac): its own password since 2026-10-17
MAC_GCE_GUEST_PASS=CHANGE_ME

# Windows 11 guest (Hyper-V / QEMU, ssh 127.0.0.1:10023)
WIN_GUEST_USER=dragos
WIN_GUEST_PASS=CHANGE_ME

# Ubuntu guest (QEMU, ssh 127.0.0.1:10024)
UBUNTU_GUEST_USER=dragos
UBUNTU_GUEST_PASS=CHANGE_ME

# Apple Screen Sharing on :5901. The RFB protocol caps VNC passwords at 8
# characters, so this is usually a truncated form of the account password.
MAC_VNC_PASS=CHANGE_M

# Hyper-V dev fleet guests (scripts/devfleet.ps1, tailscale-fleet.ps1)
FLEET_GUEST_USER=dragos
FLEET_GUEST_PASS=CHANGE_ME

# Tailscale OAuth client for the BUSINESS tailnet (brivio.ro) -- the dev fleet.
# Scopes: policy_file:write, devices:core:write, auth_keys:write.
TS_OAUTH_CLIENT_ID=CHANGE_ME
TS_OAUTH_SECRET=CHANGE_ME

# Tailscale OAuth client for the PERSONAL tailnet -- Home Assistant. A
# separate prefix on purpose: the two tailnets cannot see each other and
# mixing them up is the #1 "cannot connect" cause on this machine.
# Scopes: policy_file:write, dns:write, devices:core:write + auth_keys:write
# restricted to tag:appliance.
TS_HOME_OAUTH_CLIENT_ID=CHANGE_ME
TS_HOME_OAUTH_SECRET=CHANGE_ME

# Home Assistant appliance (scripts/ha-configure.ps1). HA_TOKEN is a
# long-lived access token from Profile -> Security. Port 80, not 8123.
HA_URL=http://192.168.100.232
HA_ADMIN_USER=dragos
HA_ADMIN_PASS=CHANGE_ME
HA_TOKEN=CHANGE_ME
HA_SAMBA_PASS=CHANGE_ME

# Custom domain for Home Assistant: Let's Encrypt DNS challenge against
# Vercel DNS. The token must belong to a member of the team owning the zone.
HA_PUBLIC_DOMAIN=home.example.com
VERCEL_API_TOKEN=CHANGE_ME
VERCEL_TEAM_ID=team_CHANGE_ME

# Devices (scripts/ha-devices.ps1)
# 2.4 GHz WiFi baked into ESPHome nodes (ESP32 cannot do 5 GHz).
HOME_WIFI_SSID=CHANGE_ME
HOME_WIFI_PASS=CHANGE_ME
# Generated by -FlashProxy on first run; must match HA's ESPHome entry.
ESPHOME_BLUETOOTHPROXY1_API_KEY=
ESPHOME_BLUETOOTHPROXY1_OTA_PASS=
# Smart Life app -> Me -> Settings -> Account -> User Code (not a secret).
TUYA_USER_CODE=CHANGE_ME
# Hisense ConnectLife app account.
CONNECTLIFE_USER=CHANGE_ME
CONNECTLIFE_PASS=CHANGE_ME
