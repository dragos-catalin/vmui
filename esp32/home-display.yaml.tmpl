# vmui home display + Bluetooth proxy — ideaspark ESP32 with 0.96" OLED.
# Rendered by scripts/esp32-display.ps1 (fills ${...} from .private/credentials.env).
#
# Board facts (measured on this unit, see docs/esp32-display.md):
#   OLED  SSD1306 128x64 I2C 0x3C on SDA=GPIO21 SCL=GPIO22 (verified: with 5/4
#         the display component fails "Communication failed"; some ideaspark
#         revisions use 5/4 — pass -Sda/-Scl to the script). Two-colour panel:
#         rows 0-15 light up YELLOW, rows 16-63 BLUE. The server renders with
#         that split in mind (yellow = title band).
#   BOOT  GPIO0, active low, pulled up — our only readable button.
#   EN    hardware reset, not a GPIO.
#   LED   GPIO2 blue/red status LED next to the module — off when healthy.
#
# Architecture: the ESP has ~300 KB free heap and no PSRAM, so it renders
# nothing. vmui (this PC) composes each "view" as a 1-bit 128x64 BMP
# (1 086 bytes) at /api/esp/display/${node} and the ESP fetches it every
# ${refresh}. Offline (PC down) it falls back to a local clock + status page.
# Button clicks are POSTed to /api/esp/button so vmui can switch views,
# pause the gallery or toggle ambilight without HA in the loop.

esphome:
  name: ${node}
  friendly_name: ${friendly}
  on_boot:
    priority: -100
    then:
      - lambda: id(boot_ms) = millis();

esp32:
  board: esp32dev
  framework:
    type: esp-idf
    advanced:
      # Moves code out of DRAM; the log asks for it and it bought ~40 KB heap.
      sram1_as_iram: true
      execute_from_psram: false

# WARN, not INFO: every log line is also serialised into the API's overflow
# buffer for connected HA/log clients, and that heap allocation is exactly
# where the board aborted (bad_alloc in APIConnection::send_buffer).
logger:
  level: WARN
  baud_rate: 115200   # keep UART on: it is the only way to read a boot loop

api:
  id: api_id
  # Three slots: HA + one log/OTA session + one spare. Each API client owns
  # a buffer; HA reconnecting through half-open sockets filled all five
  # default slots ("Max connections (5), rejecting") right before a bad_alloc
  # abort. With only two, a zombie HA socket plus a log session pinned both
  # for 5.5 h (2026-09-16): every new hello got RST at 10 ms, OTA still
  # worked, a cold power cycle did not clear it because HA reconnected into
  # the same state within seconds. The spare slot lets the next hello in so
  # the zombie gets evicted by the ping timeout.
  max_connections: 3
  # Counts only while ZERO clients are connected, so a zombie defeats it;
  # keep it short so a genuine no-client state still self-heals fast.
  reboot_timeout: 5min
  encryption:
    key: "${api_key}"
  # HA may push a one-off message (e.g. a doorbell) that overrides the gallery.
  services:
    - service: show_message
      variables:
        title: string
        body: string
        seconds: int
      then:
        - globals.set: { id: msg_title, value: !lambda 'return title;' }
        - globals.set: { id: msg_body,  value: !lambda 'return body;' }
        - globals.set: { id: msg_until, value: !lambda 'return millis() + seconds * 1000;' }
        - component.update: oled
    # Electra IA02 intercom: talk, then open. Fired by HA / vmui from the
    # phone notification. Ignored when nobody is ringing (AVP is only powered
    # during a call anyway; this just avoids relay chatter).
    - service: intercom_open
      then:
        - script.execute: intercom_open_seq

ota:
  - platform: esphome
    password: "${ota_pass}"

wifi:
  id: wifi_id
  ssid: "${wifi_ssid}"
  password: "${wifi_pass}"
  power_save_mode: none        # BLE proxy + 5 s image polls want the radio awake
  # Brownout resets ("E BOD: Brownout detector was triggered") when a WiFi
  # burst lands on top of a BLE window on this board's weak 3.3 V path. The
  # AP is 3 m away (-33 dBm); 8.5 dBm is plenty and halves the TX current.
  output_power: 8.5dB
  # No AP fallback / captive portal: ~12 KB of heap on a board that has none
  # to spare; the USB port is 30 cm away if WiFi credentials ever change.


time:
  - platform: sntp
    id: sntp_time
    timezone: Europe/Bucharest

# ---- Bluetooth proxy (the reason this board exists) ----------------------
# Heap is the constraint: BLE stack + WiFi + HTTP client + a 1 KB image on a
# no-PSRAM ESP32 aborted with bad_alloc under the default 3 active BLE
# connections. One connection is all our Tuya BLE strip needs.
# Abort site was BluetoothProxy::flush_pending_advertisements_ -> API
# overflow buffer new[] -> bad_alloc: advert bursts outran the heap. Passive
# scan halves the advert volume (no scan-response packets) and the 100/200 ms
# window still catches the Tuya strip; the display code needs the rest.
esp32_ble:
  max_connections: 1
  disable_bt_logs: true
esp32_ble_tracker:
  scan_parameters:
    active: false
    interval: 320ms
    window: 160ms   # 100 ms caught 3 of ~15 scale frames; 160 ms still leaves WiFi room
  # OKOK / Chipsea bathroom scale (${scale_mac}). Not connectable: it wakes
  # when stepped on, streams ~1 advert/s for ~15 s, then sleeps. Manufacturer
  # data = 0xC0 0x?? + 13 bytes: weight u16 BE (x0.01 kg) | res1 u16 | res2
  # u16 | props | own MAC[6]. props bit0 = locked reading, bits 3-5 = unit
  # (4 = kg). The OKOK app has no Health Connect export, so this is the only
  # path from the scale to HA. Decoded on the 2026-09-16 capture: 0x24 while
  # settling (7.1, 8.3, 64.0 kg) then 0x25 locked = 64.40 kg.
  # The "company id" is NOT constant: settling frames come as 0x00C0, locked
  # frames as 0x2CC0 / 0x70C0 (the byte after 0xC0 varies), so a
  # manufacturer_id filter drops exactly the frame we want. Match the MAC and
  # parse the raw advert instead; the frame is always the last 13 bytes of
  # the manufacturer-specific AD element.
  on_ble_advertise:
    - mac_address: ${scale_mac}
      then:
        - lambda: |-
            const auto &mds = x.get_manufacturer_datas();
            if (mds.empty()) return;
            // reassemble company id (LE) + payload = the AD element as sent
            std::vector<uint8_t> raw;
            raw.push_back(mds[0].uuid.get_uuid().uuid.uuid16 & 0xFF);
            raw.push_back(mds[0].uuid.get_uuid().uuid.uuid16 >> 8);
            raw.insert(raw.end(), mds[0].data.begin(), mds[0].data.end());
            if (raw.size() < 13 || raw[0] != 0xC0) return;
            const size_t o = raw.size() - 13;
            const uint8_t props = raw[o + 6];
            const float kg = ((raw[o] << 8) | raw[o + 1]) / 100.0f;
            const uint16_t r1 = (raw[o + 2] << 8) | raw[o + 3];
            const uint16_t r2 = (raw[o + 4] << 8) | raw[o + 5];
            ESP_LOGW("scale", "frame props=0x%02x kg=%.2f r1=%u r2=%u", props, kg, r1, r2);
            if (((props >> 3) & 7) != 4) return;   // only kg frames
            if (kg < 5.0f || kg > 250.0f) return;  // settling noise
            id(scale_live).publish_state(kg);
            id(scale_last_kg) = kg;
            id(scale_last_ms) = millis();
            if (r1 > 0) id(scale_last_r) = r1;
            if (props & 1) {
              id(scale_locked) = true;
              id(scale_weight).publish_state(kg);
              if (r1 > 0) id(scale_impedance).publish_state(r1);
            }
bluetooth_proxy:
  active: true
  connection_slots: 1

# ---- LEDs --------------------------------------------------------------------
# Blue (GPIO2): one short blink each time a new frame arrives, so a frozen
# screen is visible at a glance; otherwise dark. It also blinks steadily
# while WiFi/API are down (see the interval below).
# Red (next to USB): hardwired to 5V, not a GPIO -- cannot be turned off in
# software. Tape it or lift it.
output:
  - platform: gpio
    pin: GPIO2
    id: blue_led
  # Case power-switch LED (+ on GPIO4, - on GND). Case LEDs carry their own
  # series resistor on the lead, so the GPIO drives it directly at 3.3 V.
  - platform: gpio
    pin: GPIO4
    id: water_led
  # Electra IA02 intercom, two relays on AVP (see docs/home-assistant.md).
  # Relay 1 "Vorbire": P -> 4.7k -> diode -> AVP.  Relay 2 "Deschide": P -> diode -> AVP.
  - platform: gpio
    pin: GPIO16
    id: intercom_talk
  - platform: gpio
    pin: GPIO17
    id: intercom_open_relay

script:
  # Order and timing measured on IA01/IA02 by others and in the Electra
  # manual: the door only opens after a talk pulse, ~1.2 s each.
  - id: intercom_open_seq
    mode: single
    then:
      - if:
          condition:
            not:
              binary_sensor.is_on: intercom_ring
          then:
            - logger.log: { level: WARN, tag: intercom, format: "open requested but no call in progress; ignoring" }
          else:
            - logger.log: { level: WARN, tag: intercom, format: "open: talk" }
            - output.turn_on: intercom_talk
            - delay: 1200ms
            - output.turn_off: intercom_talk
            - delay: 1200ms
            - logger.log: { level: WARN, tag: intercom, format: "open: door" }
            - output.turn_on: intercom_open_relay
            - delay: 1200ms
            - output.turn_off: intercom_open_relay
            - http_request.post:
                url: "${intercom_url}&event=opened"
                request_headers:
                  Authorization: "${auth_header}"
                max_response_buffer_size: 128
  # n short blinks: 1 = glass added, 2 = glass undone, 3 = nothing to undo.
  - id: water_blink
    mode: restart
    parameters:
      n: int
    then:
      - repeat:
          count: !lambda 'return n;'
          then:
            - output.turn_on: water_led
            - delay: 120ms
            - output.turn_off: water_led
            - delay: 160ms

interval:
  - interval: 1s
    then:
      - if:
          condition:
            not:
              wifi.connected:
          then:
            - output.turn_on: blue_led
            - delay: 100ms
            - output.turn_off: blue_led
  # Zombie-slot watchdog. Twice on 2026-09-15/16 the API kept its slots
  # pinned by half-open HA sockets: serial showed "Max connections (3),
  # rejecting <HA>" every second while is_connected() stayed true (the zombie
  # counts as a client), so api.reboot_timeout never fired and HA logged
  # "connection dropped immediately after encrypted hello" for 5.5 h. OTA and
  # the frame fetch kept working, so vmui can see what we cannot: it reads
  # HA's binary_sensor.<node>_status and answers "reboot" once it has been
  # off for 3 min. Costs one tiny GET per minute.
  - interval: 2s
    then:
      - lambda: |-
          if (id(scale_last_ms) == 0) return;
          if (millis() - id(scale_last_ms) < 6000) return;
          if (!id(scale_locked)) {
            ESP_LOGW("scale", "burst ended without a locked frame; publishing last %.2f kg", id(scale_last_kg));
            id(scale_weight).publish_state(id(scale_last_kg));
            if (id(scale_last_r) > 0) id(scale_impedance).publish_state(id(scale_last_r));
          }
          id(scale_last_ms) = 0; id(scale_locked) = false; id(scale_last_r) = 0;
  - interval: 60s
    then:
      - if:
          condition:
            wifi.connected:
          then:
            - http_request.get:
                url: "${watchdog_url}"
                request_headers:
                  Authorization: "${auth_header}"
                capture_response: true
                max_response_buffer_size: 32
                on_response:
                  then:
                    - lambda: |-
                        if (response->status_code == 200 && body.rfind("reboot", 0) == 0) {
                          ESP_LOGW("wd", "vmui says HA lost our API for 3 min - rebooting to free slots");
                          App.safe_reboot();
                        }
  # Water pace: once a minute ask vmui whether the last glass is > 2 h old
  # (waking hours, target not met). Drives the slow pulse on the switch LED.
  - interval: 60s
    then:
      - if:
          condition:
            wifi.connected:
          then:
            - http_request.get:
                url: "${water_url}"
                request_headers:
                  Authorization: "${auth_header}"
                capture_response: true
                max_response_buffer_size: 160
                on_response:
                  then:
                    - lambda: |-
                        if (response->status_code != 200) return;
                        id(water_under_pace) = body.find("\"underPace\":true") != std::string::npos;
  # Slow pulse (1 s on / 3 s off) while under pace; the click feedback script
  # owns the LED for its ~1 s and this loop skips those ticks.
  - interval: 4s
    then:
      - if:
          condition:
            lambda: 'return id(water_under_pace) && !id(water_blink).is_running();'
          then:
            - output.turn_on: water_led
            - delay: 1s
            - output.turn_off: water_led

# ---- Display ---------------------------------------------------------------
i2c:
  sda: ${sda}
  scl: ${scl}
  frequency: 400kHz
  scan: true

http_request:
  timeout: 4s
  verify_ssl: false
  buffer_size_rx: 1200   # the frame is 1 086 bytes; default 512 forces re-reads
  buffer_size_tx: 512

globals:
  - id: boot_ms
    type: uint32_t
    initial_value: '0'
  - id: water_under_pace
    type: bool
    initial_value: 'false'
  # OKOK burst tracking: the scale sends ~1 frame/s for ~15 s and our passive
  # 100/320 ms scan window catches only some of them (2026-09-16: 3 of ~15,
  # the locked 0x25 frame missed). So the LAST frame of a burst, published
  # 6 s after the burst goes quiet, is the fallback reading.
  - id: scale_last_kg
    type: float
    initial_value: '0'
  - id: scale_last_ms
    type: uint32_t
    initial_value: '0'
  - id: scale_locked
    type: bool
    initial_value: 'false'
  - id: scale_last_r
    type: uint16_t
    initial_value: '0'
  - id: msg_title
    type: std::string
    initial_value: '""'
  - id: msg_body
    type: std::string
    initial_value: '""'
  - id: msg_until
    type: uint32_t
    initial_value: '0'
  - id: frame_ok
    type: bool
    initial_value: 'false'
  - id: frame_age_ms
    type: uint32_t
    initial_value: '0'

image:
  - platform: online_image
    id: frame
    url: "${frame_url}"
    request_headers:
      Authorization: "${auth_header}"
    format: BMP
    type: BINARY
    update_interval: ${refresh}
    on_download_finished:
      then:
        - lambda: |-
            id(frame_ok) = true;
            id(frame_age_ms) = millis();
        - component.update: oled
        - if:
            condition:
              lambda: return !cached;
            then:
              - output.turn_on: blue_led
              - delay: 40ms
              - output.turn_off: blue_led
    on_error:
      then:
        - lambda: id(frame_ok) = false;
        - component.update: oled

font:
  - file: "gfonts://Roboto"
    id: f_small
    size: 10
    glyphs: " -.:?0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
  - file: "gfonts://Roboto"
    id: f_clock
    size: 22
    glyphs: ":0123456789"

display:
  - platform: ssd1306_i2c
    id: oled
    model: SSD1306_128X64
    address: 0x3C
    # Redraws are also triggered on frame arrival; this is only the fallback
    # clock cadence.
    update_interval: 1s
    lambda: |-
      const uint32_t now = millis();
      // 1) A pushed message beats everything for its duration.
      if (id(msg_until) > now) {
        it.printf(64, 2, id(f_small), TextAlign::TOP_CENTER, "%s", id(msg_title).c_str());
        it.line(0, 15, 127, 15);
        it.printf(64, 36, id(f_small), TextAlign::CENTER, "%s", id(msg_body).c_str());
        return;
      }
      // 2) Server frame, if it arrived in the last 30 s.
      if (id(frame_ok) && now - id(frame_age_ms) < 30000) {
        it.image(0, 0, id(frame), COLOR_ON, COLOR_OFF);
        return;
      }
      // 3) Offline fallback: yellow band = status, blue = clock.
      const bool wifi_ok = id(wifi_id).is_connected();
      const bool api_ok = id(api_id).is_connected();
      it.printf(2, 2, id(f_small), TextAlign::TOP_LEFT, "%s %s",
                wifi_ok ? "wifi" : "no-wifi", api_ok ? "ha" : "no-ha");
      it.printf(126, 2, id(f_small), TextAlign::TOP_RIGHT, "pc?");
      it.line(0, 15, 127, 15);
      auto t = id(sntp_time).now();
      if (t.is_valid()) {
        it.strftime(64, 22, id(f_clock), TextAlign::TOP_CENTER, "%H:%M", t);
        it.strftime(64, 52, id(f_small), TextAlign::TOP_CENTER, "%a %d %b", t);
      } else {
        it.printf(64, 36, id(f_small), TextAlign::CENTER, "syncing time...");
      }

# ---- BOOT button: one button, three gestures --------------------------------
binary_sensor:
  # Electra IA02 ring detector: PC817 LED across P (+12 V only during a call)
  # and MP (GND) through 2.2k; collector on GPIO34 with a 10k pull-up to 3V3,
  # emitter to GND. GPIO34 is input-only and has no internal pull-up.
  - platform: gpio
    id: intercom_ring
    name: Intercom ring
    device_class: sound
    pin:
      number: GPIO34
      inverted: true
      mode:
        input: true
    filters:
      - delayed_on: 150ms     # the line carries ring cadence; hold until it is a real call
      - delayed_off: 4s       # ring pulses would otherwise flap on/off every second
    on_press:
      then:
        - logger.log: { level: WARN, tag: intercom, format: "ring" }
        - http_request.post:
            url: "${intercom_url}&event=ring"
            request_headers:
              Authorization: "${auth_header}"
            capture_response: true
            max_response_buffer_size: 200
            on_response:
              then:
                - lambda: |-
                    // vmui answers {"open":true} while auto-open is armed
                    if (response->status_code == 200 && body.find("\"open\":true") != std::string::npos) {
                      id(intercom_open_seq).execute();
                    }
                - component.update: frame
    on_release:
      then:
        - http_request.post:
            url: "${intercom_url}&event=end"
            request_headers:
              Authorization: "${auth_header}"
            max_response_buffer_size: 128
        - component.update: frame
  - platform: gpio
    id: boot_btn
    name: Button
    pin:
      number: GPIO0
      inverted: true
      mode:
        input: true
        pullup: true
    filters:
      - delayed_on: 15ms
    # Latency budget: the gesture decoder must wait for the OFF window to tell
    # single from double, so keep those windows short. The POST is fire and
    # forget; the frame refetch starts right after it.
    on_multi_click:
      - timing:
          - ON for at most 350ms
          - OFF for at least 180ms
        then:
          - http_request.post:
              url: "${button_url}&node=${node}&click=single"
              request_headers:
                Authorization: "${auth_header}"
              max_response_buffer_size: 128
          - component.update: frame
      - timing:
          - ON for at most 350ms
          - OFF for at most 180ms
          - ON for at most 350ms
          - OFF for at least 100ms
        then:
          - http_request.post:
              url: "${button_url}&node=${node}&click=double"
              request_headers:
                Authorization: "${auth_header}"
              max_response_buffer_size: 128
          - component.update: frame
      - timing:
          - ON for at least 1s
        then:
          - http_request.post:
              url: "${button_url}&node=${node}&click=long"
              request_headers:
                Authorization: "${auth_header}"
              max_response_buffer_size: 128
          - component.update: frame
  - platform: status
    name: Status
  # Case power switch (SW on GPIO13 + GND): one press = a 250 ml glass, two
  # quick presses = a 100 ml sip, hold >= 1 s = undo the last entry. Blinks
  # the switch LED with the reply. The single-click OFF window (300 ms) is
  # what tells it from a double, so a glass registers ~0.3 s after release.
  - platform: gpio
    id: water_btn
    name: Water button
    pin:
      number: GPIO13
      inverted: true
      mode:
        input: true
        pullup: true
    filters:
      - delayed_on: 20ms
    on_multi_click:
      - timing:
          - ON for at most 900ms
          - OFF for at least 300ms
        then:
          - output.turn_on: water_led   # immediate ack; the reply sets the final pattern
          - http_request.post:
              url: "${button_url}&node=${node}&click=single&btn=water"
              request_headers:
                Authorization: "${auth_header}"
              capture_response: true
              max_response_buffer_size: 200
              on_response:
                then:
                  - lambda: |-
                      id(water_under_pace) = false;
                      int n = 1;
                      auto p = body.find("\"led\":");
                      if (response->status_code == 200 && p != std::string::npos) n = body[p + 6] - '0';
                      id(water_blink).execute(n);
                  - component.update: frame   # pull the water card now, not at the next 4 s tick
              on_error:
                then:
                  - output.turn_off: water_led
                  - script.execute: { id: water_blink, n: 5 }
      - timing:
          - ON for at most 900ms
          - OFF for at most 300ms
          - ON for at most 900ms
          - OFF for at least 100ms
        then:
          - output.turn_on: water_led
          - http_request.post:
              url: "${button_url}&node=${node}&click=double&btn=water"
              request_headers:
                Authorization: "${auth_header}"
              capture_response: true
              max_response_buffer_size: 200
              on_response:
                then:
                  - lambda: |-
                      id(water_under_pace) = false;
                      int n = 1;
                      auto p = body.find("\"led\":");
                      if (response->status_code == 200 && p != std::string::npos) n = body[p + 6] - '0';
                      id(water_blink).execute(n);
                  - component.update: frame
              on_error:
                then:
                  - output.turn_off: water_led
                  - script.execute: { id: water_blink, n: 5 }
      - timing:
          - ON for at least 1s
        then:
          - http_request.post:
              url: "${button_url}&node=${node}&click=long&btn=water"
              request_headers:
                Authorization: "${auth_header}"
              capture_response: true
              max_response_buffer_size: 200
              on_response:
                then:
                  - lambda: |-
                      int n = 2;
                      auto p = body.find("\"led\":");
                      if (response->status_code == 200 && p != std::string::npos) n = body[p + 6] - '0';
                      id(water_blink).execute(n);
                  - component.update: frame
              on_error:
                then:
                  - script.execute: { id: water_blink, n: 5 }

button:
  - platform: restart
    name: Restart
  - platform: template
    name: Intercom open
    icon: mdi:door-open
    on_press:
      - script.execute: intercom_open_seq

sensor:
  # OKOK scale, fed by on_ble_manufacturer_data_advertise above
  - platform: template
    id: scale_weight
    name: "Scale weight"
    unit_of_measurement: kg
    device_class: weight
    state_class: measurement
    accuracy_decimals: 2
    icon: mdi:scale-bathroom
    # locked reading only: one value per weigh-in, not the settling stream
    filters:
      - throttle: 5s
  - platform: template
    id: scale_live
    name: "Scale live"
    unit_of_measurement: kg
    accuracy_decimals: 1
    icon: mdi:scale
    internal: true
  - platform: template
    id: scale_impedance
    name: "Scale impedance"
    unit_of_measurement: "Ω"
    accuracy_decimals: 0
    icon: mdi:omega
    entity_category: diagnostic
    filters:
      - throttle: 5s
  - platform: template
    name: Heap Free
    unit_of_measurement: B
    accuracy_decimals: 0
    update_interval: 30s
    lambda: return heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
  - platform: wifi_signal
    name: WiFi Signal
    update_interval: 60s
  - platform: uptime
    name: Uptime

text_sensor:
  - platform: wifi_info
    ip_address:
      name: IP
