# Normalise line endings. The repo is developed on Windows (core.autocrlf=true)
# but scripts/*.sh run inside WSL/Linux, where a CRLF shebang produces
# "bad interpreter: /bin/bash^M". Pin every Linux-executed file to LF.
* text=auto
apps/android/gradlew text eol=lf
apps/android/gradlew.bat text eol=crlf

*.sh   text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows-only scripts keep CRLF.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binaries.
*.png  binary
*.jpg  binary
*.ico  binary
*.qcow2 binary
*.exe  binary
pi/** text eol=lf
*.sh text eol=lf
*.service text eol=lf
deploy/** text eol=lf
firmware/** text eol=lf
