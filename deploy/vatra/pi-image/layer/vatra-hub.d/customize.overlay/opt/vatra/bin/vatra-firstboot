#!/bin/bash
# vatra-firstboot (P5-01): runs once, early, before the network setup and the stack.
#   hostname vatra-xxxx (unique per hub, shown on the boot partition and as the hotspot name),
#   root partition grown to the whole card, fresh SSH host keys.
set -euo pipefail
log() { echo "[vatra-firstboot] $*"; }
STAMP=/var/lib/vatra/firstboot.done
[ -f "$STAMP" ] && exit 0
install -d -m 0755 /var/lib/vatra

if [ "$(cat /etc/hostname 2>/dev/null)" = vatra ]; then
  name="vatra-$(head -c2 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  echo "$name" > /etc/hostname
  if grep -q '^127\.0\.1\.1' /etc/hosts; then
    # write in place: on the A/B image /etc/hosts is a bind mount from the data partition, which
    # sed -i (rename over it) cannot replace
    hosts="$(sed "s/^127\.0\.1\.1.*/127.0.1.1\t$name/" /etc/hosts)"
    printf '%s\n' "$hosts" > /etc/hosts
  else
    printf '127.0.1.1\t%s\n' "$name" >> /etc/hosts
  fi
  hostname "$name"
  log "hostname $name"
fi

# A/B image (P5-04): / is an overlay over the read-only EROFS slot; the partition that grows is
# the data partition (last on the disk), mounted by rugix-ctrl. Classic image: the root partition.
if grep -q '^AB=1' /etc/vatra-os-release 2>/dev/null; then
  dev="$(readlink -f "$(findmnt -no SOURCE /run/rugix/mounts/data 2>/dev/null || true)" 2>/dev/null || true)"
else
  dev="$(readlink -f "$(findmnt -no SOURCE /)")"
fi
part="$(basename "${dev:-none}")"
disk="$(lsblk -no PKNAME "$dev" 2>/dev/null | head -n1 || true)"
num="$(cat "/sys/class/block/$part/partition" 2>/dev/null || true)"
if [ -b "${dev:-}" ] && [ -n "$disk" ] && [ -n "$num" ]; then
  before="$(lsblk -bno SIZE "$dev")"
  growpart "/dev/$disk" "$num" && resize2fs "$dev" || log "$dev already fills the disk"
  log "grown $dev: $before -> $(lsblk -bno SIZE "$dev") bytes"
fi

if [ -f /etc/ssh/sshd_config.d/50-vatra-hostkeys.conf ]; then
  # A/B: keys on the data partition (persisted /var/lib/vatra), same across OS updates
  install -d -m 0700 /var/lib/vatra/ssh
  for t in ed25519 ecdsa rsa; do
    k="/var/lib/vatra/ssh/ssh_host_${t}_key"
    [ -f "$k" ] || ssh-keygen -q -t "$t" -N '' -f "$k" >/dev/null 2>&1 || true
  done
elif [ -d /etc/ssh ] && ! ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1; then
  ssh-keygen -A >/dev/null 2>&1 || true
fi

touch "$STAMP"
log done
