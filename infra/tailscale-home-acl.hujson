// Tailscale policy for the PERSONAL tailnet (vladulescu.catalin@gmail.com,
// taild1532d.ts.net). This is the home network: Home Assistant, phones, the
// host PC and the personal workstation VM.
//
// It is deliberately a different tailnet from infra/tailscale-acl.hujson
// (brivio.ro, the business fleet). The two cannot see each other, and that
// is the point: a compromised smart bulb must not be one hop from a project
// server holding a customer database.
//
// Source of truth: E:\gh\vmui\infra\tailscale-home-acl.hujson
// Apply with:      scripts\tailscale-home.ps1 -ApplyAcl
{
	"tagOwners": {
		// Self-owned so the OAuth client can mint pre-authorised keys for it.
		// See the note in tailscale-acl.hujson: a tag owned by a user group or
		// autogroup:admin is refused for OAuth-minted keys.
		"tag:appliance": ["tag:appliance"],
		// MarcAI ingest Cloud Run job (ephemeral nodes): may reach ONLY the RO egress
		// proxy on homepi:3128 (marcai D29). Owned by tag:appliance so the home OAuth
		// client (auth_keys limited to tag:appliance) can mint its keys; a self-owned
		// tag was refused ("requested tags [tag:marcai-ingest] are invalid or not permitted").
		"tag:marcai-ingest": ["tag:appliance"],
		// Brivio prod/staging worker (Cloud Run, ephemeral nodes): may reach ONLY the RO
		// egress proxy on homepi:3128, for gov.ro which blocks every GCP/Cloudflare egress.
		// Owned by tag:appliance so the existing home OAuth client (auth_keys limited to
		// tag:appliance) can mint keys for it; tags owned by an OAuth tag are mintable.
		"tag:brivio-egress": ["tag:appliance"],
		// homepi itself (2026-10-05): the only node allowed to Funnel, and only for
		// /hooks/contact (dragoscatalin.ro contact form -> vmui /api/hooks/contact).
		// Owned by tag:appliance (OAuth client can set it via the API) and admins.
		"tag:funnel-hooks": ["tag:appliance", "autogroup:admin"],
	},

	"hosts": {
		// Untagged Raspberry Pi running the egress proxy (pi/egress-proxy).
		"homepi": "100.82.141.110",
	},

	// Funnel ONLY for tag:funnel-hooks (homepi). Home Assistant (tag:appliance)
	// never gets it: that would publish HA on the open internet. What homepi
	// publishes is decided by `tailscale funnel status` on the Pi, which must
	// show exactly one mount: /hooks/contact (docs/fleet.md "homepi Funnel").
	"nodeAttrs": [
		{"target": ["tag:funnel-hooks"], "attr": ["funnel"]},
	],

	"grants": [
		// The tailnet owner reaches everything, including the HA admin UI, SSH
		// into the OS shell (port 22222 is the HAOS developer SSH), and the
		// add-on ports (Mosquitto 1883, Zigbee2MQTT 8099, ESPHome 6052).
		{"src": ["autogroup:member"], "dst": ["tag:appliance"], "ip": ["*"]},

		// Members always reach their own devices.
		{"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},

		// homepi lost user ownership when it became tag:funnel-hooks; these two
		// keep what autogroup:self used to give it (owner -> Pi, Pi -> owner).
		{"src": ["autogroup:member"], "dst": ["tag:funnel-hooks"], "ip": ["*"]},
		{"src": ["tag:funnel-hooks"], "dst": ["autogroup:member"], "ip": ["*"]},

		// Home Assistant may call back to member devices: mobile app push
		// via the Companion local endpoint, and Chromecast/DLNA discovery
		// for devices that also carry a Tailscale client.
		{"src": ["tag:appliance"], "dst": ["autogroup:member"], "ip": ["*"]},

		// MarcAI ingest -> RO egress proxy only. Nothing else in the house.
		{"src": ["tag:marcai-ingest"], "dst": ["homepi"], "ip": ["tcp:3128"]},

		// Brivio worker -> RO egress proxy only (brivio news ingest, gov.ro).
		{"src": ["tag:brivio-egress"], "dst": ["homepi"], "ip": ["tcp:3128"]},
	],

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	"tests": [
		{
			"src":    "vladulescu.catalin@gmail.com",
			"accept": ["tag:appliance:8123", "tag:appliance:443", "tag:funnel-hooks:22", "tag:funnel-hooks:3737", "homepi:3128"],
		},
		{
			"src":    "tag:marcai-ingest",
			"accept": ["homepi:3128"],
			"deny":   ["homepi:22", "homepi:3737", "homepi:8123", "tag:appliance:8123"],
		},
		{
			"src":    "tag:brivio-egress",
			"accept": ["homepi:3128"],
			"deny":   ["homepi:22", "homepi:3737", "homepi:8123", "tag:appliance:8123"],
		},
	],
}
