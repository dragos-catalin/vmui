            "state": "translated",
            "value": "The hub wakes this iPhone through Apple Push, with its own key or through the Vatra push relay. Turn off to get updates only while the app is open."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubul trezește acest iPhone prin Apple Push, cu cheia lui sau prin releul Vatra. Oprește ca să primești noutăți doar cu aplicația deschisă."
          }
        }
      }
    },
