    "presence_background": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the next screen choose \"Allow all the time\", otherwise Vatra cannot notice when you arrive."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe ecranul următor alege „Permite tot timpul”, altfel Vatra nu poate observa când ajungi."
          }
        }
      }
    },
    "presence_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell the hub when you arrive or leave, so automations can turn lights on or off."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anunță hubul când ajungi sau pleci, ca automatizările să aprindă sau să stingă luminile."
          }
        }
      }
    },
    "presence_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is off for Vatra. Allow it \"Always\" in Settings to notice when you arrive."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Locația e oprită pentru Vatra. Permite-o „Întotdeauna” în Configurări ca să observe când ajungi."
          }
        }
      }
    },
    "presence_disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vatra uses your location in the background, even when the app is closed, only to notice when you arrive at or leave this home. The hub receives just \"home\" or \"away\", never your position. You can turn this off at any time in Settings."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vatra folosește locația în fundal, chiar și cu aplicația închisă, doar ca să observe când ajungi sau pleci din această casă. Hubul primește doar „acasă” sau „plecat”, niciodată poziția ta. Poți opri oricând din Setări."
          }
        }
      }
    },
    "presence_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriving and leaving home"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sosire și plecare de acasă"
          }
        }
      }
    },
