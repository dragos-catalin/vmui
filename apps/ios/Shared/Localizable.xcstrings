    "nfc_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a house action to a sticker. Tapping it with any paired phone runs it with that phone's permissions; the tag holds no password."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie o acțiune pe un sticker. Atingerea cu orice telefon asociat o rulează cu permisiunile acelui telefon; eticheta nu conține nicio parolă."
          }
        }
      }
    },
    "nfc_failed": {
      "extractionState": "manual",
      "localizations": {
