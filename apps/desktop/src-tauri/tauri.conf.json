{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vatra",
  "mainBinaryName": "vmui-desktop",
  "version": "0.4.0",
  "identifier": "ro.vatra.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vatra",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#110b07"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Vatra",
    "copyright": "© 2026 Dragoș Cătălin Vlăduțescu",
    "category": "Utility",
    "shortDescription": "Vatra — your home, from the Windows tray",
    "longDescription": "Control the lights, scenes, ambilight and notifications of a Vatra home server from the Windows tray. Pairs with the hub on your network; reads nothing else on your PC.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English", "Romanian"], "displayLanguageSelector": false }
    }
  }
}
