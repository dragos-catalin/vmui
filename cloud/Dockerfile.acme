# vatra-acme (Cloud Run). Build context: cloud/
FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/vatra-acme ./cmd/acme

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/vatra-acme /vatra-acme
USER nonroot:nonroot
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/vatra-acme"]
