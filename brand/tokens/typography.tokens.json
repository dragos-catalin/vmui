{
  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Inter Variable",
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "Segoe UI",
        "Roboto",
        "sans-serif"
      ]
    },
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Inter Tight Variable",
        "Inter Tight",
        "Inter Variable",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "ui-monospace",
        "JetBrains Mono",
        "Cascadia Code",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 1.125,
        "unit": "rem"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    }
  }
}
